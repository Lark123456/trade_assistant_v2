# 1. 忽略 Python 虚拟环境 (体积巨大，绝对不能上传)
.venv/
venv/
env/
ENV/

# 2. 忽略 Python 编译缓存与临时文件
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 3. 忽略本地敏感密钥与配置文件 (保护个人 Webhook / Bark Key)
.env
config_private.json
*.pem

# 4. 忽略运行日志与系统临时文件
logs/
*.log
.DS_Store
Thumbs.db

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 5. 忽略临时测试目录
_multi_test_tmp/
__smoke_v812/

# 6. 选股日报的运行产物与工具本地状态（v0.10.4）
reports/
e2e_scan_result.txt
.dhs-workflow.json
_probe.txt

# 7. 策略内容 —— 属于核心资产，不进公开仓库（v0.10.5）
#    archive/ 是每个策略的版本归档（含逻辑说明书 + 公式原文）
#    策略备份-*.json 是「一键导出」生成的迁移包
archive/
策略备份-*.json
*策略备份*.json